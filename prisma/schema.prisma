generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model sample {
  id   String @id @db.VarChar(100)
  name String @db.VarChar(100)
}

model Customer {
  id String @id
  name String
  email String @unique
  phone String @unique

  @@map("customers")
}